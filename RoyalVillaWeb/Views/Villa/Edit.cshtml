@model RoyalVilla.DTO.VillaUpdateDTO

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Form Card -->
            <div class="card">
                <div class="card-header text-white bg-warning d-flex justify-content-between align-items-center">
                    <span class="fw-semibold h4 pt-2">Update Villa</span>
                </div>
                <div class="card-body">
                    <form method="post">

                        <!-- Villa Name -->
                        <div class="mb-3">
                            <label asp-for="@Model.Name" class="form-label">
                                Villa Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="@Model.Name" class="form-control" placeholder="Enter villa name" />
                            <span asp-validation-for="@Model.Name" class="text-danger small"></span>
                        </div>
                        <!-- Details -->
                        <div class="mb-3">
                            <label asp-for="@Model.Details" class="form-label">Description</label>
                            <textarea asp-for="@Model.Details" class="form-control" rows="4"
                                      placeholder="Describe the villa"></textarea>
                            <span asp-validation-for="@Model.Details" class="text-danger small"></span>
                        </div>
                        <!-- Rate and Occupancy -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="@Model.Rate" class="form-label">
                                    Nightly Rate <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span asp-validation-for="@Model.Rate" class="input-group-text">$</span>
                                    <input asp-for="@Model.Rate" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                </div>
                                <span class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="@Model.Occupancy" class="form-label">Max Occupancy</label>
                                <input asp-for="@Model.Occupancy" type="number" class="form-control" placeholder="Number of guests" />
                                <span asp-validation-for="@Model.Occupancy" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Sqft -->
                        <div class="mb-3">
                            <label asp-for="@Model.Sqft" class="form-label">Square Feet</label>
                            <input asp-for="@Model.Sqft" type="number" class="form-control" placeholder="Area in sqft" />
                            <span asp-validation-for="@Model.Sqft" class="text-danger small"></span>
                        </div>

                        <!-- Image URL -->
                        <div class="mb-4">
                            <label asp-for="@Model.ImageUrl" class="form-label">Image URL</label>
                            <input asp-for="@Model.ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                            <span asp-validation-for="@Model.ImageUrl" class="text-danger small"></span>
                        </div>
                        @if (!string.IsNullOrEmpty(@Model.ImageUrl))
                        {
                            <div class="text-center mb-4 mt-2">
                                <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded" style="max-height: 300px;" />
                            </div>
                        }
                        <!-- Action Buttons -->
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check me-2"></i>Update Villa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}